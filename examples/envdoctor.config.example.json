{
  "version": 1,
  "project": {
    "name": "sample-project",
    "root": "."
  },
  "diagnostics": {
    "system": true,
    "runtime": true,
    "path": true,
    "environment": true,
    "project": true,
    "git": true,
    "docker": true,
    "ports": true
  },
  "rules": {
