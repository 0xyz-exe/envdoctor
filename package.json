{
  "name": "envdoctor",
  "version": "1.0.0",
  "description": "Developer environment configuration checker, diagnostics runner, and remediation engine.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "envdoctor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js"
  },
  "keywords": [
    "developer-tools",
    "environment-checker",
    "diagnostics",
    "doctor",
    "path-validator",
    "cli",
    "devops",
    "remediation"
  ],
  "author": "0xyz-exe",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xyz-exe/envdoctor.git"
  },
  "bugs": {
    "url": "https://github.com/0xyz-exe/envdoctor/issues"
  },
  "homepage": "https://github.com/0xyz-exe/envdoctor#readme",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "5.8.2",
    "vitest": "^5.0.5"
  }
}
